	<queryString>
		<![CDATA[SELECT
    jugadores.id AS jugador_id,
    jugadores.nombre AS nombre_jugador,
    jugadores.email AS email_jugador,
    jugadores.numtelefono AS telefono_jugador,
    privacidad.nivel_de_privacidad AS nivel_de_privacidad,
    puntuaciones.valor AS valor_puntuacion
FROM
    jugadores
INNER JOIN
    puntuaciones ON puntuaciones.jugador_id = jugadores.id
INNER JOIN
    privacidad ON privacidad.jugador_id=jugadores.id
order by valor_puntuacion desc;]]>
	</queryString>
	<field name="jugador_id" class="java.lang.Integer"/>
	<field name="nombre_jugador" class="java.lang.String"/>
	<field name="email_jugador" class="java.lang.String"/>
	<field name="telefono_jugador" class="java.lang.String"/>
	<field name="nivel_de_privacidad" class="java.lang.Object"/>
	<field name="valor_puntuacion" class="java.lang.Integer"/>
