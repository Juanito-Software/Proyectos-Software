	<queryString>
		<![CDATA[SELECT
    puntuaciones.id AS puntuacion_id,
    jugadores.nombre AS nombre_jugador,
    puntuaciones.valor AS valor_puntuacion
FROM
    puntuaciones
INNER JOIN
    jugadores ON puntuaciones.jugador_id = jugadores.id order by valor_puntuacion desc;]]>
	</queryString>
	<field name="puntuacion_id" class="java.lang.Integer"/>
	<field name="nombre_jugador" class="java.lang.String"/>
	<field name="valor_puntuacion" class="java.lang.Integer"/>
