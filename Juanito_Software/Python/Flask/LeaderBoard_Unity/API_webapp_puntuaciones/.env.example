# Copia este archivo a .env y rellena los valores reales.
# El .env NO se versiona (está en el .gitignore de la raíz).

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/game

# Clave con la que se firman los JWT.
# Generar una nueva con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Quien conozca esta clave puede fabricar tokens válidos para cualquier usuario.
SECRET_KEY=

# Cuenta de correo para el envío de notificaciones.
# En Gmail hay que usar una "contraseña de aplicación", no la del correo.
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=tu_cuenta@gmail.com
