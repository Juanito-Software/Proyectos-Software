        <!-- Apache POI para manejar Excel (XLS) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version> <!-- O la versión más reciente -->
        </dependency>

        <!-- Apache POI para soporte de los formatos más recientes de Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version> <!-- O la versión más reciente -->
        </dependency>
        
        
        <!-- Dependencia de Apache POI para los esquemas de XML -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-schemas</artifactId>
            <version>4.1.2</version>
        </dependency>
        
        <!-- Dependencia de Apache Commons Collections (requerida por POI) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.4</version>
        </dependency>
        
        
        <!-- Dependencia para manejar archivos XLSX (si es necesario para exportar a XLSX) -->
