# GameChat - Variables de entorno
# Copia a .env y configura con tus valores

# Twitch
TWITCH_CHANNEL=tu_canal
TWITCH_OAUTH=oauth:xxxxxxxxxxxx
# Token OAuth: https://twitchapps.com/tmi/

# false = conectar al chat real de Twitch
# true = modo simulación (mensajes aleatorios para pruebas)
GAMECHAT_SIMULATION=true
