<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.radiostack</groupId>
        <artifactId>radiostack</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>radiostack-api</artifactId>
    <packaging>jar</packaging>

    <name>radiostack-api</name>
    <description>API REST de RadioStack</description>

    <dependencies>
        <dependency>
            <groupId>com.radiostack</groupId>
            <artifactId>radiostack-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.radiostack</groupId>
            <artifactId>radiostack-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Firma y verificacion de los tokens JWT. La version la fija el pom padre. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!--
            Tests. La version la fija el BOM de Spring Boot del pom padre.

            starter-test trae JUnit 5, Mockito (con mockito-junit-jupiter, de donde
            sale MockitoExtension) y spring-test, que es lo que aporta los dobles de
            servlet (MockHttpServletRequest y MockFilterChain) con los que se prueba
            el filtro JWT sin levantar un servidor, y tambien MockMvc.

            Casi todos estos tests construyen con `new` la clase que prueban y no
            arrancan nada. La excepcion es SecurityConfigTest, que usa @WebMvcTest:
            las reglas de acceso no son un metodo al que llamar, son el
            comportamiento de la cadena de filtros, y solo se pueden comprobar
            atravesandola.

            Aun asi, ningun test necesita PostgreSQL ni Flyway: @WebMvcTest levanta
            solo la capa web, sin JPA ni DataSource. Y la variable de entorno
            RADIOSTACK_JWT_SECRET tampoco hace falta, porque la clave de firma de
            los tests se fija por propiedad dentro de la propia clase.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
