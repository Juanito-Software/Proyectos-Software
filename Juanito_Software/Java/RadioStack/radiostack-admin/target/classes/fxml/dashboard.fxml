<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.radiostack.admin.controller.DashboardController"
            styleClass="dashboard-root" prefWidth="900" prefHeight="560">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="RADIOSTACK" styleClass="toolbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Parrilla" onAction="#verParrilla" styleClass="btn-toolbar"/>
            <Button text="Programas" onAction="#verProgramas" styleClass="btn-toolbar"/>
            <Button text="Chat en vivo" onAction="#abrirChat" styleClass="btn-toolbar"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="btn-toolbar"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="24" styleClass="dashboard-content">
            <Label fx:id="welcomeLabel" styleClass="welcome-label"/>
            <Label text="Usa el menú superior para navegar." styleClass="hint-label"/>
        </VBox>
    </center>
</BorderPane>
