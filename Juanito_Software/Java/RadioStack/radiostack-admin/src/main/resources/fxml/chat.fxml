<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.radiostack.admin.controller.ChatController"
            styleClass="dashboard-root" prefWidth="700" prefHeight="500">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="Chat en directo" styleClass="toolbar-title"/>
            <TextField fx:id="emisionIdField" promptText="ID emisión" prefWidth="80" styleClass="field-input"/>
            <Button text="Conectar" onAction="#conectar" styleClass="btn-primary"/>
            <Button text="Desconectar" onAction="#desconectar" styleClass="btn-toolbar"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="estadoLabel" text="Desconectado" styleClass="hint-label"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="8" styleClass="chat-content">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <ListView fx:id="mensajesList" VBox.vgrow="ALWAYS" styleClass="chat-list"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="aliasField" promptText="Tu alias" prefWidth="120" styleClass="field-input"/>
                <TextField fx:id="mensajeField" promptText="Mensaje..." HBox.hgrow="ALWAYS" styleClass="field-input" onAction="#enviar"/>
                <Button text="Enviar" onAction="#enviar" styleClass="btn-primary"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="8" right="16" bottom="12" left="16"/></padding>
            <Button text="Volver al dashboard" onAction="#volver" styleClass="btn-toolbar"/>
        </HBox>
    </bottom>
</BorderPane>
