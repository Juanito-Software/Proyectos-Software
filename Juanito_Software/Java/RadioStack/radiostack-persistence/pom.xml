
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.radiostack</groupId>
        <artifactId>radiostack</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>radiostack-persistence</artifactId>
    <packaging>jar</packaging>

    <name>radiostack-persistence</name>
    <description>Persistencia JPA y PostgreSQL de RadioStack</description>

    <!--
        Mockito 5 usa el mock maker inline por defecto. En Java 21 el
        auto-attach de Byte Buddy puede fallar, por lo que configuramos
        mockito-core como agente de la JVM de pruebas.
    -->
    <properties>
        <argLine></argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.radiostack</groupId>
            <artifactId>radiostack-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!--
            Tests. La version la fija el BOM de Spring Boot del pom padre.

            Este modulo no tenia ni una clase de test: 19 ficheros de codigo y
            cero cobertura, con el mapeador entre entidades JPA y dominio dentro.
            Ese mapeador es el sitio clasico donde alguien anade un campo a la
            entidad, se olvida de una de las dos direcciones, y el dato se pierde
            en silencio camino de la base de datos.

            Ningun test de aqui levanta Spring ni toca PostgreSQL: el mapeador son
            funciones puras y los adaptadores se prueban con dobles de sus
            repositorios JPA.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
	
	<dependency>
    		<groupId>net.bytebuddy</groupId>
    		<artifactId>byte-buddy-agent</artifactId>
    		<scope>test</scope>
	</dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/1.14.13/byte-buddy-agent-1.14.13.jar</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
