# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL vía Docker Compose)
DATABASE_URL="postgresql://taskmanager:taskmanager@localhost:5432/taskmanager?schema=public"

# JWT
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
