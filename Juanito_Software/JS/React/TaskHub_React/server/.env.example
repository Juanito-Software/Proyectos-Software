# Copia este fichero a .env y rellena los valores.
# .env está en .gitignore: no lo subas nunca al repositorio.

# ── Base de datos ────────────────────────────────────────────────────────────
# Local (Postgres instalado en tu máquina):
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/taskhub

# Producción (Neon). La cadena te la da el panel al crear el proyecto y ya
# incluye ?sslmode=require, que es lo que activa TLS en la conexión:
# DATABASE_URL=postgresql://usuario:password@ep-algo.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Autenticación ────────────────────────────────────────────────────────────
# Genera una clave larga y aleatoria para producción, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Duración del token de acceso. Corto a propósito: un JWT ya emitido sigue
# siendo válido hasta que caduca aunque se cierre la sesión, así que la ventana
# de exposición es exactamente este valor.
ACCESS_TOKEN_TTL=15m

# Duración del token de refresco, que sí se puede revocar porque vive en la
# base de datos. Marca cuánto dura la sesión sin volver a escribir la
# contraseña.
REFRESH_TOKEN_TTL=7d

# Segundos de tolerancia para dos renovaciones simultáneas con el mismo token
# (dos pestañas abiertas, o la aplicación y el playground a la vez). Dentro de
# esta ventana la segunda se rechaza sin revocar la sesión entera; fuera de
# ella se trata como reutilización y se revoca la familia de tokens.
REFRESH_GRACE_SECONDS=10

# Límite de intentos fallidos de autenticación por ventana de 15 minutos.
# SE IGNORA EN PRODUCCIÓN: existe para que la suite de verificación pueda
# probar contraseñas inválidas en serie sin estrangularse a sí misma.
# AUTH_RATE_LIMIT=1000

# ── Administrador ────────────────────────────────────────────────────────────
# Opcionales. Si están definidas, al arrancar se crea (o se promueve) ese
# usuario con rol de administrador.
#
# Es la ÚNICA forma de conseguir el rol admin: registrarse siempre crea
# usuarios normales y no hay ningún endpoint que promueva a nadie. Si dejas
# estas variables vacías, la aplicación funciona igual pero sin administrador.
#
# La contraseña debe tener 12 caracteres como mínimo o el servidor no arranca.
# Se reaplica en cada arranque, así que cambiarla aquí y redesplegar es la
# forma de recuperar el acceso si la pierdes.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
